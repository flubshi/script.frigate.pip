msgctxt "#32754"
msgid "Arrows: move   ·   OK: zoom   ·   Back: apply   ·   Menu: cancel"
msgstr "Pfeiltasten: verschieben   ·   OK: Zoom   ·   Zurück: übernehmen   ·   Menü: abbrechen"

msgctxt "#32755"
msgid "Zoom {zoom}"
msgstr "Zoom {zoom}"

msgctxt "#32756"
msgid "{width}×{height} source pixels"
msgstr "{width}×{height} Quellpixel"

msgctxt "#32757"
msgid "Whole picture"
msgstr "Ganzes Bild"

msgctxt "#32800"
msgid "Server: {url}"
msgstr "Server: {url}"

msgctxt "#32801"
msgid "Certificate check: {mode}"
msgstr "Zertifikatsprüfung: {mode}"

msgctxt "#32802"
msgid "[ERR] TLS connection: {error}"
msgstr "[FEHLER] TLS-Verbindung: {error}"

msgctxt "#32803"
msgid "Certificate SHA-256: {fingerprint}"
msgstr "Zertifikat SHA-256: {fingerprint}"

msgctxt "#32804"
msgid "[!] No fingerprint stored yet – run \"Fetch and trust certificate\"."
msgstr "[!] Noch kein Fingerprint hinterlegt – „Zertifikat abrufen und vertrauen“ ausführen."

msgctxt "#32805"
msgid "[ERR] The fingerprint does NOT match the stored one!"
msgstr "[FEHLER] Der Fingerprint stimmt NICHT mit dem hinterlegten überein!"

msgctxt "#32806"
msgid "      stored: {fingerprint}"
msgstr "      hinterlegt: {fingerprint}"

msgctxt "#32807"
msgid "[OK] Fingerprint matches the stored one"
msgstr "[OK] Fingerprint stimmt mit dem hinterlegten überein"

msgctxt "#32808"
msgid "[!] The certificate is not verified (insecure)"
msgstr "[!] Das Zertifikat wird nicht geprüft (unsicher)"

msgctxt "#32809"
msgid "[!] Unencrypted (HTTP) – only use this in a trusted network"
msgstr "[!] Unverschlüsselt (HTTP) – nur im vertrauenswürdigen Netz verwenden"

msgctxt "#32810"
msgid "[!] {field} contains {chars} – typical for autocorrection (e.g. \"...\" becomes \"…\"). Please check!"
msgstr "[!] {field} enthält {chars} – typisch für Autokorrektur (z. B. wird aus „...“ ein „…“). Bitte prüfen!"

msgctxt "#32811"
msgid "[i] {field} contains {count} non-ASCII characters (e.g. umlauts) – just a note"
msgstr "[i] {field} enthält {count} Nicht-ASCII-Zeichen (z. B. Umlaute) – nur ein Hinweis"

msgctxt "#32812"
msgid "[OK] Logged in as \"{user}\""
msgstr "[OK] Angemeldet als „{user}“"

msgctxt "#32813"
msgid "[ERR] Login: {error}"
msgstr "[FEHLER] Login: {error}"

msgctxt "#32814"
msgid "Login: none configured (only suitable for port 5000)"
msgstr "Login: keiner eingetragen (nur für Port 5000 geeignet)"

msgctxt "#32815"
msgid "Frigate version: {version}"
msgstr "Frigate-Version: {version}"

msgctxt "#32816"
msgid "[!] Version not available: {error}"
msgstr "[!] Version nicht abrufbar: {error}"

msgctxt "#32817"
msgid "[ERR] Camera list (/api/config): {error}"
msgstr "[FEHLER] Kameraliste (/api/config): {error}"

msgctxt "#32818"
msgid "[OK] Cameras: {cameras}"
msgstr "[OK] Kameras: {cameras}"

msgctxt "#32819"
msgid "{camera} (disabled)"
msgstr "{camera} (deaktiviert)"

msgctxt "#32820"
msgid "[OK] Picture {camera}: {size} KB in {ms} ms"
msgstr "[OK] Bild {camera}: {size} KB in {ms} ms"

msgctxt "#32821"
msgid "[ERR] Picture {camera}: {error}"
msgstr "[FEHLER] Bild {camera}: {error}"

msgctxt "#32822"
msgid "[OK] Statistics: {cameras}"
msgstr "[OK] Statistik: {cameras}"

msgctxt "#32823"
msgid "no camera data"
msgstr "keine Kameradaten"

msgctxt "#32824"
msgid "[i] Statistics: no permission – stall detection still works"
msgstr "[i] Statistik: keine Berechtigung – die Hänger-Erkennung funktioniert trotzdem"

msgctxt "#32825"
msgid "[!] Statistics: {error}"
msgstr "[!] Statistik: {error}"

msgctxt "#32826"
msgid "[OK] RTSP port {host}:{port} reachable (camera full screen: {url})"
msgstr "[OK] RTSP-Port {host}:{port} erreichbar (Kamera-Vollbild: {url})"

msgctxt "#32827"
msgid "[i] No RTSP user configured – needed if go2rtc requires RTSP credentials"
msgstr "[i] Kein RTSP-Benutzer eingetragen – nötig, falls go2rtc RTSP-Zugangsdaten verlangt"

msgctxt "#32828"
msgid "[!] RTSP port {host}:{port} not reachable ({error}) – camera full screen will not work"
msgstr "[!] RTSP-Port {host}:{port} nicht erreichbar ({error}) – das Kamera-Vollbild wird nicht funktionieren"

msgctxt "#32829"
msgid "[OK] Zoom: Pillow {version} available"
msgstr "[OK] Zoom: Pillow {version} vorhanden"

msgctxt "#32830"
msgid "[ERR] Zoom is enabled, but Pillow (PIL) is missing"
msgstr "[FEHLER] Zoom ist aktiviert, aber Pillow (PIL) fehlt"

msgctxt "#32831"
msgid "Test finished."
msgstr "Test abgeschlossen."

msgctxt "#32832"
msgid "[ERR] Unexpected error: {error} (details in kodi.log)"
msgstr "[FEHLER] Unerwarteter Fehler: {error} (Details im kodi.log)"

msgctxt "#32833"
msgid "[ERR] No server configured – run the setup wizard first."
msgstr "[FEHLER] Kein Server eingetragen – zuerst den Einrichtungsassistenten starten."

msgctxt "#32834"
msgid "User name"
msgstr "Benutzername"

msgctxt "#32835"
msgid "Password"
msgstr "Passwort"

msgctxt "#32900"
msgid "Frigate PiP – setup"
msgstr "Frigate PiP – Einrichtung"

msgctxt "#32901"
msgid "Frigate PiP shows your Frigate cameras as picture-in-picture.[CR]Set it up now? It takes about two minutes."
msgstr "Frigate PiP zeigt deine Frigate-Kameras als Bild-in-Bild.[CR]Jetzt einrichten? Das dauert etwa zwei Minuten."

msgctxt "#32902"
msgid "This wizard connects Kodi to your Frigate server.[CR]You need: the address of the Frigate server and – if Frigate uses a login – a Frigate user (the \"viewer\" role is enough)."
msgstr "Dieser Assistent verbindet Kodi mit deinem Frigate-Server.[CR]Du brauchst: die Adresse des Frigate-Servers und – falls Frigate einen Login verwendet – einen Frigate-Benutzer (die Rolle „viewer“ reicht)."

msgctxt "#32903"
msgid "Address of the Frigate server (e.g. 192.168.1.10)"
msgstr "Adresse des Frigate-Servers (z. B. 192.168.1.10)"

msgctxt "#32904"
msgid "\"{address}\" is not a valid address.[CR]Enter a host name or IP address, optionally with a port, e.g. 192.168.1.10 or frigate.local:8971."
msgstr "„{address}“ ist keine gültige Adresse.[CR]Gib einen Hostnamen oder eine IP-Adresse ein, optional mit Port, z. B. 192.168.1.10 oder frigate.local:8971."

msgctxt "#32905"
msgid "Searching for Frigate …"
msgstr "Suche Frigate …"

msgctxt "#32906"
msgid "Trying {url} …"
msgstr "Versuche {url} …"

msgctxt "#32907"
msgid "No Frigate found.[CR]{details}[CR]Check the address and whether port 8971 (or 5000) is enabled in Frigate. Try again?"
msgstr "Kein Frigate gefunden.[CR]{details}[CR]Prüfe die Adresse und ob Port 8971 (oder 5000) in Frigate freigegeben ist. Erneut versuchen?"

msgctxt "#32908"
msgid "Port 8123 is Home Assistant. Please enter the address of the Frigate server – usually the same host without port, Frigate uses port 8971."
msgstr "Port 8123 ist Home Assistant. Bitte gib die Adresse des Frigate-Servers ein – meist derselbe Host ohne Port, Frigate verwendet Port 8971."

msgctxt "#32909"
msgid "Try again"
msgstr "Erneut versuchen"

msgctxt "#32910"
msgid "Frigate found at {url}, but without encryption: your password would be sent in plain text through your network.[CR]Continue anyway?"
msgstr "Frigate gefunden unter {url}, aber ohne Verschlüsselung: Dein Passwort würde im Klartext durchs Netz gehen.[CR]Trotzdem fortfahren?"

msgctxt "#32911"
msgid "Frigate found at {url}.[CR]This port has no login: everyone in your network can use the complete Frigate API there. Port 8971 with login is the safer choice.[CR]Continue anyway?"
msgstr "Frigate gefunden unter {url}.[CR]Dieser Port hat keinen Login: Jeder in deinem Netz kann dort die komplette Frigate-API nutzen. Port 8971 mit Login ist die sicherere Wahl.[CR]Trotzdem fortfahren?"

msgctxt "#32912"
msgid "Frigate uses a self-signed certificate. Its SHA-256 fingerprint is:[CR]{fingerprint}[CR]If you want to be sure, compare it on the Frigate host. Trust this certificate for {host}:{port}?"
msgstr "Frigate verwendet ein selbstsigniertes Zertifikat. Sein SHA-256-Fingerprint lautet:[CR]{fingerprint}[CR]Wenn du sichergehen willst, vergleiche ihn auf dem Frigate-Host. Diesem Zertifikat für {host}:{port} vertrauen?"

msgctxt "#32913"
msgid "Frigate user name"
msgstr "Frigate-Benutzername"

msgctxt "#32914"
msgid "Password"
msgstr "Passwort"

msgctxt "#32915"
msgid "The password contains {chars}. Such characters are often inserted by autocorrection (e.g. \"...\" becomes \"…\").[CR]Use the password as entered?"
msgstr "Das Passwort enthält {chars}. Solche Zeichen fügt oft die Autokorrektur ein (z. B. wird aus „...“ ein „…“).[CR]Passwort so verwenden?"

msgctxt "#32916"
msgid "Logging in …"
msgstr "Melde an …"

msgctxt "#32917"
msgid "Login failed:[CR]{error}"
msgstr "Login fehlgeschlagen:[CR]{error}"

msgctxt "#32918"
msgid "Loading cameras …"
msgstr "Lade Kameras …"

msgctxt "#32919"
msgid "Frigate does not report any active camera yet. You can choose the cameras later."
msgstr "Frigate meldet noch keine aktive Kamera. Du kannst die Kameras später auswählen."

msgctxt "#32920"
msgid "Frigate could not be reached:[CR]{error}[CR]Try again?"
msgstr "Frigate ist nicht erreichbar:[CR]{error}[CR]Erneut versuchen?"

msgctxt "#32921"
msgid "Default camera (for the toggle key and calls without camera)"
msgstr "Standardkamera (für die Toggle-Taste und Aufrufe ohne Kamera)"

msgctxt "#32922"
msgid "None – ask each time"
msgstr "Keine – jedes Mal fragen"

msgctxt "#32923"
msgid "Set up \"camera full screen\" now?[CR]It plays the camera stream (RTSP via go2rtc in Frigate) in the Kodi player. You can also do this later in the settings."
msgstr "„Kamera-Vollbild“ jetzt einrichten?[CR]Damit läuft der Kamerastream (RTSP über go2rtc in Frigate) im Kodi-Player. Du kannst das auch später in den Einstellungen tun."

msgctxt "#32924"
msgid "RTSP user name (leave empty if go2rtc needs none)"
msgstr "RTSP-Benutzer (leer lassen, falls go2rtc keinen verlangt)"

msgctxt "#32925"
msgid "RTSP password"
msgstr "RTSP-Passwort"

msgctxt "#32926"
msgid "The RTSP port {host}:{port} is not reachable ({error}). Camera full screen needs it – check the go2rtc/Frigate port settings later."
msgstr "Der RTSP-Port {host}:{port} ist nicht erreichbar ({error}). Das Kamera-Vollbild braucht ihn – prüfe später die Port-Einstellungen von go2rtc/Frigate."

msgctxt "#32928"
msgid "Setup complete.[CR]Show a test picture of \"{camera}\" now?"
msgstr "Einrichtung abgeschlossen.[CR]Jetzt ein Testbild von „{camera}“ anzeigen?"

msgctxt "#32929"
msgid "Setup cancelled – nothing was changed"
msgstr "Einrichtung abgebrochen – nichts wurde geändert"

msgctxt "#32930"
msgid "Setup complete"
msgstr "Einrichtung abgeschlossen"

msgctxt "#32931"
msgid "Cancel"
msgstr "Abbrechen"

msgctxt "#32933"
msgid "Next"
msgstr "Weiter"

msgctxt "#32934"
msgid "Yes"
msgstr "Ja"

msgctxt "#32935"
msgid "No"
msgstr "Nein"
