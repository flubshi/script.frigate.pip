msgid "no picture received · {age}"
msgstr "kein Bild erhalten · {age}"

msgctxt "#32711"
msgid "NO PICTURE · {age}"
msgstr "KEIN BILD · {age}"

msgctxt "#32750"
msgid "OK: camera full screen  ·  Back: close"
msgstr "OK: Kamera im Vollbild  ·  Zurück: schließen"

msgctxt "#32751"
msgid "Back: close  ·  other keys control Kodi"
msgstr "Zurück: schließen  ·  andere Tasten bedienen Kodi"

msgctxt "#32752"
msgid "Image section for {camera}"
msgstr "Ausschnitt für {camera}"

