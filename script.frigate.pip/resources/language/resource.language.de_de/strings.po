msgctxt "#32000"
msgid "."
msgstr ","

msgctxt "#32001"
msgid "Frigate PiP is not set up yet.[CR]Start the setup wizard now?"
msgstr "Frigate PiP ist noch nicht eingerichtet.[CR]Einrichtungsassistent jetzt starten?"

msgctxt "#32002"
msgid "Frigate PiP is not set up yet – open the add-on to start the setup"
msgstr "Frigate PiP ist noch nicht eingerichtet – Addon öffnen, um die Einrichtung zu starten"

msgctxt "#32003"
msgid "Unknown camera: {cameras}"
msgstr "Unbekannte Kamera: {cameras}"

msgctxt "#32004"
msgid "Zoom not available: the Python library Pillow is missing"
msgstr "Zoom nicht verfügbar: Die Python-Bibliothek Pillow fehlt"

msgctxt "#32005"
msgid "Zoom is switched off in the settings"
msgstr "Zoom ist in den Einstellungen ausgeschaltet"

msgctxt "#32006"
msgid "{camera}: whole picture saved"
msgstr "{camera}: ganzes Bild gespeichert"

msgctxt "#32007"
msgid "{camera}: section {zoom} saved"
msgstr "{camera}: Ausschnitt {zoom} gespeichert"

msgctxt "#32008"
msgid "Frigate PiP – choose camera"
msgstr "Frigate PiP – Kamera wählen"

msgctxt "#32009"
msgid "All cameras ({count})"
msgstr "Alle Kameras ({count})"

msgctxt "#32010"
msgid "{camera} – image section"
msgstr "{camera} – Bildausschnitt"

msgctxt "#32011"
msgid "Saved section ({zoom})"
msgstr "Gespeicherter Ausschnitt ({zoom})"

msgctxt "#32012"
msgid "Whole picture"
msgstr "Ganzes Bild"

msgctxt "#32013"
msgid "Define new section …"
msgstr "Neuen Ausschnitt festlegen …"

msgctxt "#32014"
msgid "Camera list not available – run the connection test in the settings"
msgstr "Kameraliste nicht abrufbar – Verbindungstest in den Einstellungen ausführen"

msgctxt "#32015"
msgid "No active cameras found"
msgstr "Keine aktiven Kameras gefunden"

msgctxt "#32016"
msgid "Frigate PiP – confirm certificate"
msgstr "Frigate PiP – Zertifikat bestätigen"

msgctxt "#32017"
msgid "First connection to {host}:{port}.[CR]SHA-256 fingerprint:[CR]{fingerprint}[CR]Trust this certificate permanently?"
msgstr "Erste Verbindung zu {host}:{port}.[CR]SHA-256-Fingerprint:[CR]{fingerprint}[CR]Diesem Zertifikat dauerhaft vertrauen?"

msgctxt "#32018"
msgid "Certificate not confirmed – see settings"
msgstr "Zertifikat nicht bestätigt – siehe Einstellungen"

msgctxt "#32019"
msgid "Frigate not reachable: {error}"
msgstr "Frigate nicht erreichbar: {error}"

msgctxt "#32020"
msgid "Unknown action: {action}"
msgstr "Unbekannte Aktion: {action}"

msgctxt "#32021"
msgid "Background service is not running – enable the add-on or restart Kodi"
msgstr "Hintergrunddienst läuft nicht – Addon aktivieren oder Kodi neu starten"

msgctxt "#32022"
msgid "Camera stream {camera} could not be started – check the RTSP settings"
msgstr "Kamerastream {camera} konnte nicht gestartet werden – RTSP-Einstellungen prüfen"

msgctxt "#32023"
msgid "Zoom not possible: {reason}"
msgstr "Zoom nicht möglich: {reason}"

msgctxt "#32024"
msgid "{camera}: {status}"
msgstr "{camera}: {status}"

msgctxt "#32025"
msgid "WARNING: The certificate has CHANGED.[CR]New SHA-256 fingerprint:[CR]{fingerprint}[CR]Frigate creates a new built-in certificate when its container is recreated. Compare the fingerprint on the Frigate host before you confirm."
msgstr "ACHTUNG: Das Zertifikat hat sich GEÄNDERT.[CR]Neuer SHA-256-Fingerprint:[CR]{fingerprint}[CR]Frigate erzeugt ein neues eingebautes Zertifikat, wenn sein Container neu erstellt wird. Vergleiche den Fingerprint auf dem Frigate-Host, bevor du bestätigst."

msgctxt "#32026"
msgid "Server {host}:{port}[CR]SHA-256 fingerprint:[CR]{fingerprint}[CR]Trust this certificate?"
msgstr "Server {host}:{port}[CR]SHA-256-Fingerprint:[CR]{fingerprint}[CR]Diesem Zertifikat vertrauen?"

msgctxt "#32027"
msgid "This certificate is already trusted:[CR]{fingerprint}"
msgstr "Dieses Zertifikat ist bereits hinterlegt:[CR]{fingerprint}"

msgctxt "#32028"
msgid "Certificate saved"
msgstr "Zertifikat gespeichert"

msgctxt "#32029"
msgid "Please enter the Frigate server first or run the setup wizard."
msgstr "Bitte zuerst den Frigate-Server eintragen oder den Einrichtungsassistenten starten."

msgctxt "#32030"
msgid "HTTPS is switched off – there is no certificate to check."
msgstr "HTTPS ist ausgeschaltet – es gibt kein Zertifikat zu prüfen."

msgctxt "#32031"
msgid "Connection to {host}:{port} failed:[CR]{error}"
msgstr "Verbindung zu {host}:{port} fehlgeschlagen:[CR]{error}"

msgctxt "#32032"
msgid "Unexpected error – details in kodi.log"
msgstr "Unerwarteter Fehler – Details im kodi.log"

msgctxt "#32033"
msgid "Connection test"
msgstr "Verbindungstest"

msgctxt "#32034"
msgid "Testing connection …"
msgstr "Teste Verbindung …"

msgctxt "#32035"
msgid "Frigate – {camera}"
msgstr "Frigate – {camera}"

msgctxt "#32100"
msgid "Connection"
msgstr "Verbindung"

msgctxt "#32101"
msgid "Frigate server"
msgstr "Frigate-Server"

msgctxt "#32102"
msgid "Login"
msgstr "Anmeldung"

msgctxt "#32103"
msgid "Certificate (HTTPS)"
msgstr "Zertifikat (HTTPS)"

msgctxt "#32104"
msgid "Tools"
msgstr "Werkzeuge"

msgctxt "#32105"
msgid "Setup"
msgstr "Einrichtung"

msgctxt "#32106"
msgid "Run setup wizard"
msgstr "Einrichtungsassistent starten"

msgctxt "#32107"
msgid "Guides you through server address, certificate, login and default camera."
msgstr "Führt durch Serveradresse, Zertifikat, Login und Standardkamera."

msgctxt "#32110"
msgid "Host or IP address"
msgstr "Host oder IP-Adresse"

msgctxt "#32111"
msgid "Address of the Frigate server, e.g. 192.168.1.10 or frigate.local"
msgstr "Adresse des Frigate-Servers, z. B. 192.168.1.10 oder frigate.local"

msgctxt "#32112"
msgid "Port"
msgstr "Port"

msgctxt "#32113"
msgid "Use HTTPS"
msgstr "HTTPS verwenden"

msgctxt "#32114"
msgid "Port 8971 = authenticated API with HTTPS. Port 5000 = internal API without login (HTTP, only if exposed)."
msgstr "Port 8971 = authentifizierte API mit HTTPS. Port 5000 = interne API ohne Login (HTTP, nur falls freigegeben)."

msgctxt "#32115"
msgid "User name"
msgstr "Benutzername"

msgctxt "#32116"
msgid "Frigate user, ideally with the \"viewer\" role. Leave empty for port 5000."
msgstr "Frigate-Benutzer, am besten mit der Rolle „viewer“. Für Port 5000 leer lassen."

msgctxt "#32117"
msgid "Password"
msgstr "Passwort"

msgctxt "#32120"
msgid "Certificate check"
msgstr "Zertifikatsprüfung"

msgctxt "#32121"
msgid "Pin fingerprint (recommended)"
msgstr "Fingerprint pinnen (empfohlen)"

msgctxt "#32122"
msgid "Verify with system CAs"
msgstr "Über System-CAs prüfen"

msgctxt "#32123"
msgid "No verification (insecure)"
msgstr "Keine Prüfung (unsicher)"

msgctxt "#32124"
msgid "SHA-256 fingerprint"
msgstr "SHA-256-Fingerprint"

msgctxt "#32125"
msgid "Fetch and trust certificate"
msgstr "Zertifikat abrufen und vertrauen"

msgctxt "#32126"
msgid "Test connection"
msgstr "Verbindung testen"

msgctxt "#32127"
msgid "Pinning accepts exactly the confirmed certificate (works with self-signed certificates). System CAs require a valid certificate for this host name. 'No verification' accepts any certificate and should only be used deliberately."
msgstr "Pinnen akzeptiert genau das bestätigte Zertifikat (funktioniert mit selbstsignierten Zertifikaten). System-CAs verlangen ein gültiges Zertifikat für diesen Hostnamen. „Keine Prüfung“ akzeptiert jedes Zertifikat und sollte nur bewusst gewählt werden."

msgctxt "#32128"
msgid "Filled in by \"Fetch and trust certificate\". A different certificate is rejected."
msgstr "Wird über „Zertifikat abrufen und vertrauen“ gefüllt. Ein abweichendes Zertifikat wird abgelehnt."

msgctxt "#32129"
msgid "Connects to the server, shows the certificate fingerprint and stores it after confirmation."
msgstr "Verbindet sich mit dem Server, zeigt den Fingerprint des Zertifikats und speichert ihn nach Bestätigung."

msgctxt "#32130"
msgid "Checks TLS, login, camera list, pictures, statistics and RTSP and shows a report."
msgstr "Prüft TLS, Login, Kameraliste, Bilder, Statistik und RTSP und zeigt einen Bericht."

msgctxt "#32200"
msgid "Overlay"
msgstr "Overlay"

msgctxt "#32201"
msgid "Appearance"
msgstr "Darstellung"

msgctxt "#32202"
msgid "Behaviour"
msgstr "Verhalten"

msgctxt "#32210"
msgid "Position"
msgstr "Position"

msgctxt "#32211"
msgid "Top right"
msgstr "Oben rechts"

msgctxt "#32212"
msgid "Top left"
msgstr "Oben links"

msgctxt "#32213"
msgid "Bottom right"
msgstr "Unten rechts"

msgctxt "#32214"
msgid "Bottom left"
msgstr "Unten links"

msgctxt "#32215"
msgid "Width per camera (% of screen width)"
msgstr "Breite pro Kamera (% der Bildschirmbreite)"

msgctxt "#32216"
msgid "Display time in seconds (0 = until closed)"
msgstr "Anzeigedauer in Sekunden (0 = bis zum Schließen)"

msgctxt "#32219"
msgid "Show object boxes (bounding boxes)"
msgstr "Objekt-Markierungen (Bounding Boxes) einblenden"

msgctxt "#32220"
msgid "Show timestamp in picture"
msgstr "Zeitstempel ins Bild einblenden"

msgctxt "#32221"
msgid "Polling interval (ms)"
msgstr "Abfrageintervall (ms)"

msgctxt "#32222"
msgid "Default camera(s)"
msgstr "Standardkamera(s)"

msgctxt "#32223"
msgid "Used when no camera is given (e.g. toggle key). Separate several cameras with +. Empty = ask."
msgstr "Für Aufrufe ohne Kamera (z. B. Toggle-Taste). Mehrere Kameras mit + trennen. Leer = nachfragen."

msgctxt "#32224"
msgid "Frigate draws the frame time into the picture – a stopped clock makes a frozen picture obvious."
msgstr "Frigate zeichnet die Bildzeit ins Bild – eine stehende Uhr macht ein eingefrorenes Bild sofort sichtbar."

msgctxt "#32225"
msgid "Frigate updates the picture at the detect frame rate (typically 5 fps); polling faster than every 200 ms brings no benefit."
msgstr "Frigate aktualisiert das Bild mit der Detect-Bildrate (typisch 5 fps); schneller als alle 200 ms abzufragen bringt nichts."

msgctxt "#32234"
msgid "Key for camera full screen"
msgstr "Taste für Kamera-Vollbild"

msgctxt "#32235"
msgid "Closes the overlay and plays the camera's RTSP stream in the Kodi video player. Afterwards the previous playback continues."
msgstr "Schließt das Overlay und spielt den RTSP-Stream der Kamera im Kodi-Videoplayer. Danach geht die vorherige Wiedergabe weiter."

msgctxt "#32236"
msgid "OK (only during full screen video)"
msgstr "OK (nur bei Videowiedergabe im Vollbild)"

msgctxt "#32237"
msgid "Info"
msgstr "Info"

msgctxt "#32238"
msgid "Context menu"
msgstr "Kontextmenü"

msgctxt "#32239"
msgid "None (only via command)"
msgstr "Keine (nur per Befehl)"

msgctxt "#32240"
msgid "Show PiP again after seconds without key press (0 = no)"
msgstr "PiP wieder einblenden nach Sekunden ohne Tastendruck (0 = nein)"

msgctxt "#32241"
msgid "Kodi treats add-on overlays as modal. So that Kodi stays fully usable, any key except player keys hides the PiP and acts normally in Kodi. Once you stop pressing keys, the PiP comes back. Back/Exit closes it for good."
msgstr "Kodi behandelt Addon-Overlays als modal. Damit Kodi voll bedienbar bleibt, blendet jede Taste außer den Player-Tasten das PiP aus und wirkt ganz normal in Kodi. Drückst du eine Weile keine Taste, kommt das PiP zurück. Zurück/Exit schließt es endgültig."

msgctxt "#32242"
msgid "Show key hint when opening"
msgstr "Tastenhinweis beim Öffnen anzeigen"

msgctxt "#32243"
msgid "Shows for a few seconds which keys close the PiP or open the camera in full screen."
msgstr "Zeigt einige Sekunden lang, welche Tasten das PiP schließen bzw. die Kamera im Vollbild öffnen."

msgctxt "#32300"
msgid "Monitoring"
msgstr "Überwachung"

msgctxt "#32301"
msgid "Stall detection"
msgstr "Hänger-Erkennung"

msgctxt "#32310"
msgid "Warning (yellow) after ms without new picture"
msgstr "Warnung (gelb) nach ms ohne neues Bild"

msgctxt "#32311"
msgid "Error (red) after ms without new picture"
msgstr "Fehler (rot) nach ms ohne neues Bild"

msgctxt "#32312"
msgid "Kodi notification on error"
msgstr "Kodi-Benachrichtigung bei Fehler"

msgctxt "#32313"
msgid "Query Frigate statistics"
msgstr "Frigate-Statistik abfragen"

msgctxt "#32314"
msgid "A picture counts as new when its content changes. If Frigate keeps delivering the same picture, the stream is considered frozen."
msgstr "Ein Bild gilt als neu, wenn sich sein Inhalt ändert. Liefert Frigate immer dasselbe Bild, gilt der Stream als eingefroren."

msgctxt "#32315"
msgid "Shows whether the camera itself delivers frames to Frigate (camera_fps). Needs read access to /api/stats."
msgstr "Zeigt, ob die Kamera selbst Frames an Frigate liefert (camera_fps). Benötigt Lesezugriff auf /api/stats."

msgctxt "#32400"
msgid "Zoom"
msgstr "Zoom"

msgctxt "#32401"
msgid "Image section"
msgstr "Bildausschnitt"

msgctxt "#32410"
msgid "Enable zoom / image section"
msgstr "Zoom/Bildausschnitt aktivieren"

msgctxt "#32411"
msgid "Needs the Python library Pillow. When off, pictures are shown unchanged and never decoded."
msgstr "Benötigt die Python-Bibliothek Pillow. Wenn aus, werden Bilder unverändert angezeigt und nie dekodiert."

msgctxt "#32412"
msgid "Ask for section after selecting a camera"
msgstr "Nach Kameraauswahl nach Ausschnitt fragen"

msgctxt "#32413"
msgid "Applies to manual selection. Calls from Home Assistant always use the saved section (or full=1 for the whole picture)."
msgstr "Gilt für die manuelle Auswahl. Aufrufe aus Home Assistant nutzen immer den gespeicherten Ausschnitt (oder full=1 für das ganze Bild)."

msgctxt "#32414"
msgid "Define section ..."
msgstr "Ausschnitt festlegen ..."

msgctxt "#32415"
msgid "Arrow keys move the frame, OK cycles the zoom, Back saves, Menu cancels."
msgstr "Pfeiltasten verschieben den Rahmen, OK schaltet den Zoom um, Zurück speichert, Menü bricht ab."

msgctxt "#32500"
msgid "Camera full screen"
msgstr "Kamera-Vollbild"

msgctxt "#32501"
msgid "RTSP stream (go2rtc in Frigate)"
msgstr "RTSP-Stream (go2rtc in Frigate)"

msgctxt "#32510"
msgid "RTSP host (empty = Frigate server)"
msgstr "RTSP-Host (leer = Frigate-Server)"

msgctxt "#32511"
msgid "Only needed if the RTSP stream runs on a different host."
msgstr "Nur nötig, wenn der RTSP-Stream auf einem anderen Host läuft."

msgctxt "#32512"
msgid "RTSP port"
msgstr "RTSP-Port"

msgctxt "#32513"
msgid "RTSP user name"
msgstr "RTSP-Benutzer"

msgctxt "#32514"
msgid "RTSP password"
msgstr "RTSP-Passwort"

msgctxt "#32515"
msgid "Stream name"
msgstr "Stream-Name"

msgctxt "#32516"
msgid "{camera} is replaced by the camera name, e.g. {camera}_main for a separate main stream."
msgstr "{camera} wird durch den Kameranamen ersetzt, z. B. {camera}_main für einen eigenen Hauptstream."

msgctxt "#32517"
msgid "Resume previous playback afterwards"
msgstr "Danach vorherige Wiedergabe fortsetzen"

msgctxt "#32518"
msgid "When the camera stream is stopped, the previous video continues at its position or the previous TV channel is tuned again. Not if you started something else meanwhile."
msgstr "Wird der Kamerastream beendet, läuft das vorherige Video an der alten Stelle weiter bzw. der vorherige Sender wird wieder eingeschaltet. Nicht, wenn du inzwischen selbst etwas anderes gestartet hast."

